# ============================================================
# SWARMOS Environment Configuration
# Nebius x NVIDIA Global AI Hackathon 2026
# ============================================================

# Nebius Token Factory & AI Studio API Settings
# Base URL for Nebius Token Factory OpenAI-compatible API
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Your Nebius API Key (Generate at https://studio.nebius.ai)
# If left empty, SWARMOS transparently runs in deterministic simulation mode.
NEBIUS_API_KEY=

# NVIDIA Open-Source Reasoning Model on Nebius Token Factory
# Primary Flagship Model:
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Fallback / Edge Reasoning Model:
NEBIUS_FALLBACK_MODEL=nvidia/nemotron-mini-4b-instruct

# Execution Mode: Set to "true" to force deterministic local reasoning
MOCK_AI=false

# Server Configuration
SWARMOS_HOST=0.0.0.0
SWARMOS_PORT=8000
SWARMOS_DEBUG=false

# Simulation & Telemetry Loop Rates
SIMULATION_TICK_RATE_HZ=10.0
TELEMETRY_BROADCAST_RATE_HZ=5.0
