# ============================================================
# SWARMOS Frontend Environment Configuration (Vite / Vercel)
# ============================================================

# Backend REST API URL (leave empty if served on same host/port or via reverse proxy)
# In production on Vercel, set to your deployed backend URL:
# Example: VITE_API_URL=https://api.swarmos.ai
VITE_API_URL=

# Backend WebSocket Telemetry URL (leave empty to derive from window.location.host)
# In production on Vercel, set to your deployed WebSocket endpoint:
# Example: VITE_WS_URL=wss://api.swarmos.ai/ws/telemetry
VITE_WS_URL=

# SECURITY NOTICE:
# NEVER expose NEBIUS_API_KEY or any LLM provider keys in frontend code or VITE_* variables.
# All inference is brokered exclusively by the secure backend.
